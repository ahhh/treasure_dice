{
  "name": "treasure-dice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "text": "vite --config text-editor/vite.config.ts",
    "text:context": "node scripts/ui-context.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "node scripts/ui-all.mjs",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/sim.ts",
    "playtest": "node scripts/playtest.ts",
    "art-spec": "node scripts/export-art-spec.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  }
}
